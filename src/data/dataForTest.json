              "tipo": "p",
              "texto": "Métricas essenciais para garantir uma boa experiência de usuário e ranqueamento no Google."
            },
            {
              "tipo": "tabela",
              "cabecalho": [
                "Sigla",
                "Nome Completo",
                "O que mede",
                "Meta Ideal"
              ],
              "linhas": [
                [
                  "LCP",
                  "Largest Contentful Paint",
                  "Velocidade de carregamento",
                  "< 2.5s"
                ],
                [
                  "FID",
                  "First Input Delay",
                  "Interatividade (sendo substituído pelo INP)",
                  "< 100ms"
                ],
                [
                  "CLS",
                  "Cumulative Layout Shift",
                  "Estabilidade Visual",
                  "< 0.1"
                ],
                [
                  "INP",
                  "Interaction to Next Paint",
                  "Responsividade geral",
                  "< 200ms"
                ],
                [
                  "TTFB",
                  "Time to First Byte",
                  "Resposta do Servidor",
                  "< 800ms"
                ]
              ]
            }
          ]
        }
      ]
